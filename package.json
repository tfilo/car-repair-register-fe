{
    "name": "car-repair-register-fe",
    "author": {
        "name": "Tomáš Filo",
        "url": "https://github.com/tfilo/car-repair-register-fe"
    },
    "license": "MIT",
    "version": "1.3.8",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run apigen && tsc -b && vite build",
        "build:dev": "npm run apigen && tsc -b && CYPRESS_COVERAGE=true vite build -m development",
        "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
        "lint:fix": "eslint 'src/**/*.{js,jsx,ts,tsx}' --fix",
        "prettier": "prettier 'src/**/*.{js,jsx,ts,tsx}' --check",
        "prettier:fix": "prettier 'src/**/*.{js,jsx,ts,tsx}' --write",
        "apigen": "rimraf src/api/openapi && openapi-generator-cli generate",
        "cy:open": "npm run cy:clear && cypress open --e2e --browser electron",
        "cy:run": "npm run cy:clear && cypress run --browser electron",
        "cy:clear": "rimraf cypress/results/*.xml",
        "licenseReport": "license-report --package=./package.json --output=table --config license-report.json > ./LIBRARIES"
    },
    "dependencies": {
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@cypress/code-coverage": "3.14.7",
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@eslint/js": "9.23.0",
        "@fontsource/roboto": "5.3.0",
        "@hookform/resolvers": "4.1.3",
        "@mui/icons-material": "6.5.0",
        "@mui/material": "6.5.0",
        "@mui/x-date-pickers": "7.29.4",
        "@openapitools/openapi-generator-cli": "2.42.2",
        "@tanstack/eslint-plugin-query": "5.107.2",
        "@tanstack/react-query": "5.107.2",
        "@tanstack/react-query-devtools": "5.107.2",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.3",
        "@tanstack/router-plugin": "1.169.0",
        "@types/lodash": "4.17.27",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "4.7.0",
        "cypress": "14.5.4",
        "date-fns": "4.4.0",
        "eslint": "9.39.4",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.8",
        "globals": "16.5.0",
        "license-report": "6.8.6",
        "lodash": "4.18.1",
        "mocha-junit-reporter": "2.2.1",
        "oidc-client-ts": "3.5.0",
        "pg": "8.23.1",
        "prettier": "3.10.1",
        "react-hook-form": "7.92.0",
        "react-oidc-context": "3.3.1",
        "rimraf": "6.1.4",
        "sass-embedded": "1.108.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.73.0",
        "use-debounce": "10.1.1",
        "vite": "6.4.3",
        "vite-plugin-html": "3.2.2",
        "vite-plugin-istanbul": "7.2.1",
        "vite-plugin-minify": "2.1.0",
        "yup": "1.7.1",
        "yup-locales": "1.2.28"
    }
}
